# Para producción usar la plantilla completa `.env_example_produccion`
# (APP_ENV=production, rate limits 30/5/30, SESSION_SECURE_COOKIE=true).
# Este archivo es solo para desarrollo local.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
BCRYPT_ROUNDS=12
CONTACT_RETENTION_DAYS=365
# Retención de logs de auditoría (audit:prune se ejecuta a diario a las 04:23).
AUDIT_RETENTION_DAYS=400
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portalpg2026
DB_USERNAME=portalpg
DB_PASSWORD=
# prefer | require | verify-ca | verify-full (require+ en producción)
DB_SSLMODE=prefer
# Codificación de la conexión: la BD de producción es LATIN9 (ISO-8859-15)
# pero la conexión va SIEMPRE en UTF8 (PostgreSQL convierte en el cable) y
# el texto se translitera en la app. No cambiar a latin9 (mojibake).
# Verificar con: SHOW server_encoding; SHOW client_encoding;
# DB_CHARSET=utf8

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=60
# Seguro por defecto salvo APP_ENV=local (desarrollo HTTP).
# En producción debe ser siempre true (HTTPS obligatorio).
# SESSION_SECURE_COOKIE=true

# Topes de tasa por IP (ajustables; ver app/Providers/RouteServiceProvider.php).
# El bloqueo real de fuerza bruta (AuthController) es configurable:
# LOGIN_LOCKOUT_ATTEMPTS intentos fallidos -> LOGIN_LOCKOUT_DECAY segundos.
# LOGIN_RATE_LIMIT=60
# CONTACT_RATE_LIMIT=10
# SEARCH_RATE_LIMIT=60
# LOGIN_LOCKOUT_ATTEMPTS=5
# LOGIN_LOCKOUT_DECAY=60

# Proxies/hosts de confianza (CSV). Vacío = ninguno. Ver docs/DOCUMENTACION.md §14.F.
# TRUSTED_PROXIES=
# TRUSTED_HOSTS=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
