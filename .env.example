# Para producción usar la plantilla completa `.env_example_produccion`
# (APP_ENV=production, rate limits 30/5/30, SESSION_SECURE_COOKIE=true).
# Este archivo es solo para desarrollo local.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portalpg2026
DB_USERNAME=portalpg
DB_PASSWORD=
# prefer | require | verify-ca | verify-full (require+ en producción)
DB_SSLMODE=prefer

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Seguro por defecto salvo APP_ENV=local (desarrollo HTTP).
# En producción debe ser siempre true (HTTPS obligatorio).
# SESSION_SECURE_COOKIE=true

# Topes de tasa por IP (ajustables; ver app/Providers/RouteServiceProvider.php).
# El bloqueo real de fuerza bruta es: 5 intentos fallidos de login -> 60 s.
# LOGIN_RATE_LIMIT=60
# CONTACT_RATE_LIMIT=10
# SEARCH_RATE_LIMIT=60

# Proxies/hosts de confianza (CSV). Vacío = ninguno. Ver DOCUMENTACION.md §14.F.
# TRUSTED_PROXIES=
# TRUSTED_HOSTS=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
