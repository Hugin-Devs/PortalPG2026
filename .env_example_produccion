# ============================================================================
# PLANTILLA DE PRODUCCIÓN — Portal GDC
# ----------------------------------------------------------------------------
# Copiar a `.env` en el servidor (nunca copiar el `.env` de desarrollo) y
# completar los valores reales marcados con «completar». Guía completa:
# DOCUMENTACION.md §14 (Despliegue en Producción), en especial §14.D y §14.F.
# ============================================================================

APP_NAME="Portal GDC"
APP_ENV=production
# Generar en el servidor (php artisan key:generate) o pegar la clave existente.
# Una clave nueva invalida sesiones y tokens existentes.
APP_KEY=
BCRYPT_ROUNDS=12
CONTACT_RETENTION_DAYS=365
APP_DEBUG=false
# Dominio real del portal (completar):
APP_URL=https://portal.gdc.gob.ve

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# BD dedicada de producción (completar):
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portalpg2026
DB_USERNAME=
DB_PASSWORD=
# Obligatorio en producción: verificar TLS del servidor PostgreSQL.
DB_SSLMODE=require
# La BD de producción es LATIN9 (ISO-8859-15). La conexión va SIEMPRE en
# UTF8 (PostgreSQL convierte LATIN9 <-> UTF-8 en el cable) y el texto se
# translitera en la app antes de guardarlo (DOCUMENTACION.md §14.K).
# NO cambiar DB_CHARSET a latin9: provocaría mojibake. Verificar en el
# servidor con: SHOW server_encoding;  SHOW client_encoding;
# (server_encoding=LATIN9, client_encoding=UTF8)
# DB_CHARSET=utf8

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie de sesión solo por HTTPS (obligatorio con APP_ENV=production).
SESSION_SECURE_COOKIE=true

# Topes de tasa por IP/minuto (más estrictos que los defaults de desarrollo
# 60/10/60). El bloqueo de fuerza bruta de login es 5 fallos -> 60 s.
LOGIN_RATE_LIMIT=30
CONTACT_RATE_LIMIT=5
SEARCH_RATE_LIMIT=30

# Auditoría de actividad (G6) — recomendado en producción.
AUDIT_ENABLED=true

# Proxies y hosts de confianza (CSV de IPs/CIDR o dominios; vacío = ninguno).
# Ejemplos: TRUSTED_PROXIES=10.0.0.5, 192.168.1.0/24   ·   TRUSTED_HOSTS=portal.gdc.gob.ve
# Ver DOCUMENTACION.md §14.F.4.
TRUSTED_PROXIES=
TRUSTED_HOSTS=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP real (el host por defecto de desarrollo NO existe en producción) —
# completar con los datos del servidor de correo institucional:
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@gdc.gob.ve
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
